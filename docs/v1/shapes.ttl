shape:AnimalEvent-notes a sh:PropertyShape ;
    sh:path agfoda:notes ;
    sh:name "notes" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:AnimalEvent-createdAt a sh:PropertyShape ;
    sh:path agfoda:createdAt ;
    sh:name "createdAt" ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
