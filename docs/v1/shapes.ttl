shape:Product-c-3 a sh:NodeShape ;
    sh:targetClass agfoda:Product ;
    sh:message "registrationNumber is set where category is PLANT_PROTECTION or VETERINARY_MEDICINE (Product)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:category ; sh:minCount 1 ; sh:in ( agfoda:ProductCategory_PLANT_PROTECTION agfoda:ProductCategory_VETERINARY_MEDICINE ) ] ] [ sh:path agfoda:registrationNumber ; sh:minCount 1 ] ) .



