    sh:name "createdByJobId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:maxCount 1 .

shape:SustainabilityIndicator-clientId a sh:PropertyShape ;
    sh:path agfoda:clientId ;
    sh:name "clientId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:SustainabilityIndicator-V04-1 a sh:NodeShape ;
    sh:targetClass agfoda:SustainabilityIndicator ;
    sh:message "V04: createdByUserId is set where originType is USER (SustainabilityIndicator)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_USER ) ] ] [ sh:path agfoda:createdByUser ; sh:minCount 1 ] ) .

shape:SustainabilityIndicator-V04-2 a sh:NodeShape ;
    sh:targetClass agfoda:SustainabilityIndicator ;
    sh:message "V04: createdByJobId is set where originType is SERVICE (SustainabilityIndicator)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_SERVICE ) ] ] [ sh:path agfoda:createdByJob ; sh:minCount 1 ] ) .

shape:SustainabilityIndicator-V01-3 a sh:NodeShape ;
    sh:targetClass agfoda:SustainabilityIndicator ;
    sh:message "V01: periodEnd is not earlier than periodStart (SustainabilityIndicator)."@en ;
    sh:property [ sh:path agfoda:periodStart ; sh:lessThanOrEquals agfoda:periodEnd ;
        sh:message "V01: periodEnd is not earlier than periodStart (SustainabilityIndicator)."@en ] .



# --- CodeMapping (P14, Annex A.47) ---------------------------------------

shape:CodeMapping a sh:NodeShape ;
    rdfs:label "CodeMapping" ;
    sh:targetClass agfoda:CodeMapping ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:CodeMapping-id ,
        shape:CodeMapping-conceptUri ,
        shape:CodeMapping-externalScheme ,
        shape:CodeMapping-externalCode ,
        shape:CodeMapping-label ,
        shape:CodeMapping-validFrom ,
        shape:CodeMapping-validTo ,
        shape:CodeMapping-isPreferred ,
        shape:CodeMapping-createdAt ,
        shape:CodeMapping-updatedAt ,
        shape:CodeMapping-originType ,
        shape:CodeMapping-createdByUserId ,
        shape:CodeMapping-createdByJobId ,
        shape:CodeMapping-clientId .

shape:CodeMapping-id a sh:PropertyShape ;
    sh:path agfoda:id ;
    sh:name "id" ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-conceptUri a sh:PropertyShape ;
    sh:path agfoda:conceptUri ;
    sh:name "conceptUri" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-externalScheme a sh:PropertyShape ;
    sh:path agfoda:externalScheme ;
    sh:name "externalScheme" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-externalCode a sh:PropertyShape ;
    sh:path agfoda:externalCode ;
    sh:name "externalCode" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-label a sh:PropertyShape ;
    sh:path agfoda:label ;
    sh:name "label" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:CodeMapping-validFrom a sh:PropertyShape ;
    sh:path agfoda:codeMappingValidFrom ;
    sh:name "validFrom" ;
    sh:datatype xsd:date ;
    sh:maxCount 1 .

shape:CodeMapping-validTo a sh:PropertyShape ;
    sh:path agfoda:validTo ;
    sh:name "validTo" ;
    sh:datatype xsd:date ;
    sh:maxCount 1 .

shape:CodeMapping-isPreferred a sh:PropertyShape ;
    sh:path agfoda:isPreferred ;
    sh:name "isPreferred" ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shape:CodeMapping-createdAt a sh:PropertyShape ;
    sh:path agfoda:createdAt ;
    sh:name "createdAt" ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-updatedAt a sh:PropertyShape ;
    sh:path agfoda:updatedAt ;
    sh:name "updatedAt" ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-originType a sh:PropertyShape ;
    sh:path agfoda:originType ;
    sh:name "originType" ;
    sh:in ( agfoda:OriginType_USER agfoda:OriginType_SERVICE agfoda:OriginType_DEVICE agfoda:OriginType_IMPORT agfoda:OriginType_SYSTEM ) ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:CodeMapping-createdByUserId a sh:PropertyShape ;
    sh:path agfoda:createdByUser ;
    sh:name "createdByUserId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:maxCount 1 .

shape:CodeMapping-createdByJobId a sh:PropertyShape ;
    sh:path agfoda:createdByJob ;
    sh:name "createdByJobId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:maxCount 1 .

shape:CodeMapping-clientId a sh:PropertyShape ;
    sh:path agfoda:clientId ;
    sh:name "clientId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:CodeMapping-V04-1 a sh:NodeShape ;
    sh:targetClass agfoda:CodeMapping ;
    sh:message "V04: createdByUserId is set where originType is USER (CodeMapping)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_USER ) ] ] [ sh:path agfoda:createdByUser ; sh:minCount 1 ] ) .

shape:CodeMapping-V04-2 a sh:NodeShape ;
    sh:targetClass agfoda:CodeMapping ;
    sh:message "V04: createdByJobId is set where originType is SERVICE (CodeMapping)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_SERVICE ) ] ] [ sh:path agfoda:createdByJob ; sh:minCount 1 ] ) .

shape:CodeMapping-V01-3 a sh:NodeShape ;
    sh:targetClass agfoda:CodeMapping ;
    sh:message "V01: validTo is not earlier than validFrom (CodeMapping)."@en ;
    sh:property [ sh:path agfoda:codeMappingValidFrom ; sh:lessThanOrEquals agfoda:validTo ;
        sh:message "V01: validTo is not earlier than validFrom (CodeMapping)."@en ] .
