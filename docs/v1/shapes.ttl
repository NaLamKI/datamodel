    sh:targetClass agfoda:InputOutput ;
    sh:message "V03: Exactly one of activityId, cultivationPeriodId, animalId, animalGroupId is set (InputOutput)."@en ;
    sh:xone ( [ sh:path agfoda:activityId ; sh:minCount 1 ] [ sh:path agfoda:cultivationPeriodId ; sh:minCount 1 ] [ sh:path agfoda:animalId ; sh:minCount 1 ] [ sh:path agfoda:animalGroupId ; sh:minCount 1 ] ) .



