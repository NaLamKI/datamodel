shape:Device-V04-1 a sh:NodeShape ;
    sh:targetClass agfoda:Device ;
    sh:message "V04: createdByUserId is set where originType is USER (Device)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_USER ) ] ] [ sh:path agfoda:createdByUser ; sh:minCount 1 ] ) .

shape:Device-V04-2 a sh:NodeShape ;
    sh:targetClass agfoda:Device ;
    sh:message "V04: createdByJobId is set where originType is SERVICE (Device)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_SERVICE ) ] ] [ sh:path agfoda:createdByJob ; sh:minCount 1 ] ) .

shape:Device-c-3 a sh:NodeShape ;
    sh:targetClass agfoda:Device ;
    sh:message "At most one of siteId, regionId, machineId, animalId is set (Device)."@en ;
    sh:not [ sh:property [ sh:path agfoda:siteId ; sh:minCount 1 ] , [ sh:path agfoda:regionId ; sh:minCount 1 ] ] ,
        [ sh:property [ sh:path agfoda:siteId ; sh:minCount 1 ] , [ sh:path agfoda:machineId ; sh:minCount 1 ] ] ,
        [ sh:property [ sh:path agfoda:siteId ; sh:minCount 1 ] , [ sh:path agfoda:animalId ; sh:minCount 1 ] ] ,
        [ sh:property [ sh:path agfoda:regionId ; sh:minCount 1 ] , [ sh:path agfoda:machineId ; sh:minCount 1 ] ] ,
        [ sh:property [ sh:path agfoda:regionId ; sh:minCount 1 ] , [ sh:path agfoda:animalId ; sh:minCount 1 ] ] ,
        [ sh:property [ sh:path agfoda:machineId ; sh:minCount 1 ] , [ sh:path agfoda:animalId ; sh:minCount 1 ] ] .



