    sh:name "defaultUnit" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Product-gtin a sh:PropertyShape ;
    sh:path agfoda:gtin ;
    sh:name "gtin" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Product-safetyInfo a sh:PropertyShape ;
