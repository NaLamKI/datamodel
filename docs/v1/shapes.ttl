shape:Budget a sh:NodeShape ;
    rdfs:label "Budget" ;
    sh:targetClass agfoda:Budget ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Budget-id ,
        shape:Budget-name ,
        shape:Budget-farmId ,
        shape:Budget-scopeType ,
        shape:Budget-periodStart ,
        shape:Budget-periodEnd ,
        shape:Budget-currency ,
        shape:Budget-scopeRefId ,
        shape:Budget-plannedRevenue ,
        shape:Budget-plannedCosts ,
        shape:Budget-notes ,
        shape:Budget-createdAt ,
        shape:Budget-updatedAt ,
        shape:Budget-originType ,
        shape:Budget-createdByUserId ,
        shape:Budget-createdByJobId ,
        shape:Budget-clientId .

