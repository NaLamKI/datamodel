    sh:datatype xsd:integer ;
    sh:maxCount 1 .

shape:Product-organicApproved a sh:PropertyShape ;
    sh:path agfoda:organicApproved ;
    sh:name "organicApproved" ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

shape:Product-externalId a sh:PropertyShape ;
    sh:path agfoda:externalId ;
    sh:name "externalId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Product-externalProvider a sh:PropertyShape ;
    sh:path agfoda:externalProvider ;
    sh:name "externalProvider" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Product-createdAt a sh:PropertyShape ;
    sh:path agfoda:createdAt ;
    sh:name "createdAt" ;
