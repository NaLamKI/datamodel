    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_SERVICE ) ] ] [ sh:path agfoda:createdByJob ; sh:minCount 1 ] ) .

shape:FeedRation-V01-3 a sh:NodeShape ;
    sh:targetClass agfoda:FeedRation ;
    sh:message "V01: validTo is not earlier than validFrom (FeedRation)."@en ;
    sh:property [ sh:path agfoda:feedRationValidFrom ; sh:lessThanOrEquals agfoda:validTo ;
        sh:message "V01: validTo is not earlier than validFrom (FeedRation)."@en ] .



