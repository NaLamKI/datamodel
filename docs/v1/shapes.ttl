    sh:targetClass agfoda:Stand ;
    sh:message "V08: clearingDate is not earlier than plantingDate (Stand)."@en ;
    sh:property [ sh:path agfoda:plantingDate ; sh:lessThanOrEquals agfoda:clearingDate ;
        sh:message "V08: clearingDate is not earlier than plantingDate (Stand)."@en ] .



