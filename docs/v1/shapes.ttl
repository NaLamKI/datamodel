    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:maxCount 1 .

shape:Activity-clientId a sh:PropertyShape ;
    sh:path agfoda:clientId ;
    sh:name "clientId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Activity-V04-1 a sh:NodeShape ;
    sh:targetClass agfoda:Activity ;
    sh:message "V04: createdByUserId is set where originType is USER (Activity)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_USER ) ] ] [ sh:path agfoda:createdByUser ; sh:minCount 1 ] ) .

shape:Activity-V04-2 a sh:NodeShape ;
    sh:targetClass agfoda:Activity ;
    sh:message "V04: createdByJobId is set where originType is SERVICE (Activity)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_SERVICE ) ] ] [ sh:path agfoda:createdByJob ; sh:minCount 1 ] ) .

shape:Activity-c-3 a sh:NodeShape ;
    sh:targetClass agfoda:Activity ;
    sh:message "At least one of cultivationPeriodId, regionId, siteId, animalGroupId is set (Activity)."@en ;
    sh:or ( [ sh:path agfoda:cultivationPeriodId ; sh:minCount 1 ] [ sh:path agfoda:regionId ; sh:minCount 1 ] [ sh:path agfoda:siteId ; sh:minCount 1 ] [ sh:path agfoda:animalGroupId ; sh:minCount 1 ] ) .

shape:Activity-V01-4 a sh:NodeShape ;
    sh:targetClass agfoda:Activity ;
    sh:message "V01: endsAt is not earlier than startsAt (Activity)."@en ;
    sh:property [ sh:path agfoda:startsAt ; sh:lessThanOrEquals agfoda:endsAt ;
        sh:message "V01: endsAt is not earlier than startsAt (Activity)."@en ] .



