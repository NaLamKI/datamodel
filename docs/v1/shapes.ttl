shape:AnimalEvent-V03-3 a sh:NodeShape ;
    sh:targetClass agfoda:AnimalEvent ;
    sh:message "V03: Exactly one of animalId, animalGroupId is set (AnimalEvent)."@en ;
    sh:xone ( [ sh:path agfoda:animalId ; sh:minCount 1 ] [ sh:path agfoda:animalGroupId ; sh:minCount 1 ] ) .



