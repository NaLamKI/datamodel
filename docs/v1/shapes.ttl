shape:Budget-V01-3 a sh:NodeShape ;
    sh:targetClass agfoda:Budget ;
    sh:message "V01: periodEnd is not earlier than periodStart (Budget)."@en ;
    sh:property [ sh:path agfoda:periodStart ; sh:lessThanOrEquals agfoda:periodEnd ;
        sh:message "V01: periodEnd is not earlier than periodStart (Budget)."@en ] .



