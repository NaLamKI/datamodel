    sh:path agfoda:originType ;
    sh:name "originType" ;
    sh:in ( agfoda:OriginType_USER agfoda:OriginType_SERVICE agfoda:OriginType_DEVICE agfoda:OriginType_IMPORT agfoda:OriginType_SYSTEM ) ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Budget-createdByUserId a sh:PropertyShape ;
    sh:path agfoda:createdByUser ;
    sh:name "createdByUserId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
