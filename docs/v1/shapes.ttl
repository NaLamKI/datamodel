shape:Product a sh:NodeShape ;
    rdfs:label "Product" ;
    sh:targetClass agfoda:Product ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Product-id ,
        shape:Product-name ,
        shape:Product-category ,
        shape:Product-typeUri ,
        shape:Product-manufacturer ,
        shape:Product-registrationNumber ,
        shape:Product-composition ,
        shape:Product-defaultUnit ,
        shape:Product-gtin ,
        shape:Product-safetyInfo ,
        shape:Product-withdrawalPeriodDays ,
        shape:Product-organicApproved ,
        shape:Product-externalId ,
        shape:Product-externalProvider ,
        shape:Product-createdAt ,
        shape:Product-updatedAt ,
        shape:Product-originType ,
        shape:Product-createdByUserId ,
        shape:Product-createdByJobId ,
        shape:Product-clientId .

