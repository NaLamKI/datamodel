    sh:or ( [ sh:not [ sh:path agfoda:serviceType ; sh:minCount 1 ; sh:in ( agfoda:ServiceType_CUSTOM ) ] ] [ sh:path agfoda:typeUri ; sh:minCount 1 ] ) .



