        shape:Device-farmId ,
        shape:Device-siteId ,
        shape:Device-regionId ,
        shape:Device-machineId ,
        shape:Device-animalId ,
        shape:Device-description ,
        shape:Device-sensorThingsUrl ,
        shape:Device-manufacturer ,
        shape:Device-serialNumber ,
        shape:Device-status ,
        shape:Device-externalId ,
        shape:Device-externalProvider ,
        shape:Device-createdAt ,
        shape:Device-updatedAt ,
