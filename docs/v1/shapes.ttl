    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_SERVICE ) ] ] [ sh:path agfoda:createdByJob ; sh:minCount 1 ] ) .

shape:ActivityResource-V03-3 a sh:NodeShape ;
    sh:targetClass agfoda:ActivityResource ;
    sh:message "V03: Exactly one of machineId, workerId is set (ActivityResource)."@en ;
    sh:xone ( [ sh:path agfoda:machineId ; sh:minCount 1 ] [ sh:path agfoda:workerId ; sh:minCount 1 ] ) .

shape:ActivityResource-c-4 a sh:NodeShape ;
    sh:targetClass agfoda:ActivityResource ;
    sh:message "machineId is set where resourceType is MACHINE (ActivityResource)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:resourceType ; sh:minCount 1 ; sh:in ( agfoda:ResourceType_MACHINE ) ] ] [ sh:path agfoda:machineId ; sh:minCount 1 ] ) .

shape:ActivityResource-c-5 a sh:NodeShape ;
    sh:targetClass agfoda:ActivityResource ;
    sh:message "workerId is set where resourceType is WORKER (ActivityResource)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:resourceType ; sh:minCount 1 ; sh:in ( agfoda:ResourceType_WORKER ) ] ] [ sh:path agfoda:workerId ; sh:minCount 1 ] ) .

shape:ActivityResource-V01-6 a sh:NodeShape ;
    sh:targetClass agfoda:ActivityResource ;
