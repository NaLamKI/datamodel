shape:AnimalEvent-V04-1 a sh:NodeShape ;
    sh:targetClass agfoda:AnimalEvent ;
    sh:message "V04: createdByUserId is set where originType is USER (AnimalEvent)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_USER ) ] ] [ sh:path agfoda:createdByUser ; sh:minCount 1 ] ) .

shape:AnimalEvent-V04-2 a sh:NodeShape ;
