    sh:in ( agfoda:ProductCategory_SEED agfoda:ProductCategory_PLANT_MATERIAL agfoda:ProductCategory_FERTILIZER agfoda:ProductCategory_PLANT_PROTECTION agfoda:ProductCategory_FEED agfoda:ProductCategory_VETERINARY_MEDICINE agfoda:ProductCategory_FUEL agfoda:ProductCategory_HARVEST_PRODUCT agfoda:ProductCategory_ANIMAL_PRODUCT agfoda:ProductCategory_OTHER ) ;
