# --- Organization (P1, Annex A.1) --------------------------------------

shape:Organization a sh:NodeShape ;
    rdfs:label "Organization" ;
    sh:targetClass agfoda:Organization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Organization-id ,
        shape:Organization-name ,
        shape:Organization-legalForm ,
        shape:Organization-vatId ,
        shape:Organization-registrationNumbers ,
        shape:Organization-roleUris ,
        shape:Organization-addressId ,
        shape:Organization-externalId ,
        shape:Organization-externalProvider ,
        shape:Organization-createdAt ,
        shape:Organization-updatedAt ,
        shape:Organization-originType ,
        shape:Organization-createdByUserId ,
        shape:Organization-createdByJobId ,
        shape:Organization-clientId .

shape:Organization-id a sh:PropertyShape ;
    sh:path agfoda:id ;
    sh:name "id" ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Organization-name a sh:PropertyShape ;
    sh:path agfoda:name ;
    sh:name "name" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Organization-legalForm a sh:PropertyShape ;
    sh:path agfoda:legalForm ;
    sh:name "legalForm" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Organization-vatId a sh:PropertyShape ;
    sh:path agfoda:vatId ;
    sh:name "vatId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Organization-registrationNumbers a sh:PropertyShape ;
    sh:path agfoda:registrationNumbers ;
    sh:name "registrationNumbers" ;
    sh:datatype rdf:JSON ;
    sh:maxCount 1 .

shape:Organization-roleUris a sh:PropertyShape ;
    sh:path agfoda:roleUris ;
    sh:name "roleUris" ;
    sh:nodeKind sh:IRI .

shape:Organization-addressId a sh:PropertyShape ;
    sh:path agfoda:addressId ;
    sh:name "addressId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:maxCount 1 .

shape:Organization-externalId a sh:PropertyShape ;
    sh:path agfoda:externalId ;
    sh:name "externalId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Organization-externalProvider a sh:PropertyShape ;
    sh:path agfoda:externalProvider ;
    sh:name "externalProvider" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Organization-createdAt a sh:PropertyShape ;
    sh:path agfoda:createdAt ;
    sh:name "createdAt" ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Organization-updatedAt a sh:PropertyShape ;
    sh:path agfoda:updatedAt ;
    sh:name "updatedAt" ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Organization-originType a sh:PropertyShape ;
    sh:path agfoda:originType ;
    sh:name "originType" ;
    sh:in ( agfoda:OriginType_USER agfoda:OriginType_SERVICE agfoda:OriginType_DEVICE agfoda:OriginType_IMPORT agfoda:OriginType_SYSTEM ) ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Organization-createdByUserId a sh:PropertyShape ;
    sh:path agfoda:createdByUser ;
    sh:name "createdByUserId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:maxCount 1 .

shape:Organization-createdByJobId a sh:PropertyShape ;
    sh:path agfoda:createdByJob ;
    sh:name "createdByJobId" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
