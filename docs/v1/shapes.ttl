    sh:name "clientId" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

shape:Product-V04-1 a sh:NodeShape ;
    sh:targetClass agfoda:Product ;
    sh:message "V04: createdByUserId is set where originType is USER (Product)."@en ;
    sh:or ( [ sh:not [ sh:path agfoda:originType ; sh:minCount 1 ; sh:in ( agfoda:OriginType_USER ) ] ] [ sh:path agfoda:createdByUser ; sh:minCount 1 ] ) .

shape:Product-V04-2 a sh:NodeShape ;
