shape:Observation a sh:NodeShape ;
    rdfs:label "Observation" ;
    sh:targetClass agfoda:Observation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shape:Observation-id ,
        shape:Observation-observedPropertyUri ,
        shape:Observation-phenomenonTime ,
        shape:Observation-regionId ,
        shape:Observation-fieldId ,
        shape:Observation-siteId ,
        shape:Observation-animalId ,
        shape:Observation-machineId ,
        shape:Observation-resultValue ,
        shape:Observation-resultUnit ,
        shape:Observation-resultJson ,
        shape:Observation-deviceId ,
        shape:Observation-dataId ,
        shape:Observation-source ,
        shape:Observation-validity ,
        shape:Observation-createdAt ,
        shape:Observation-updatedAt ,
        shape:Observation-originType ,
        shape:Observation-createdByUserId ,
        shape:Observation-createdByJobId ,
        shape:Observation-clientId .

shape:Observation-id a sh:PropertyShape ;
    sh:path agfoda:id ;
    sh:name "id" ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:minCount 1 ;
    sh:maxCount 1 .

shape:Observation-observedPropertyUri a sh:PropertyShape ;
