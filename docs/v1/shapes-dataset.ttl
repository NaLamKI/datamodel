<https://datamodel.agrifooddata.org/v1/shapes-dataset> a owl:Ontology ;
    dct:title "AgriFoodData model – dataset shapes"@en ;
    dct:description "SHACL shapes for a dataset of the AgriFoodData model: they need the records referred to and the concept schemes of the ontology in the data graph."@en ;
    owl:versionInfo "1.0.0-draft.3" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .


