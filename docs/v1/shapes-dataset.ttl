shape:Activity-bbchStage-notation a sh:NodeShape ;
    sh:targetClass agfoda:Activity ;
    sh:sparql [
        sh:message "bbchStage {?value} is not a notation of https://w3id.org/agrifooddata/phenology"@en ;
        sh:select "SELECT $this ?value WHERE { $this <https://w3id.org/agrifooddata/term/bbchStage> ?value . FILTER NOT EXISTS { ?concept <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/agrifooddata/phenology> ; <http://www.w3.org/2004/02/skos/core#notation> ?notation . FILTER (STR(?notation) = STR(?value)) } }" ] .

