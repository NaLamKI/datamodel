          sh:message "A reference points at a record of the entity it names: createdByUserId at User (ServiceCatalogue)."@en ] ,
        [ sh:path agfoda:createdByJob ; sh:class agfoda:ProcessingJob ;
          sh:message "A reference points at a record of the entity it names: createdByJobId at ProcessingJob (ServiceCatalogue)."@en ] .

