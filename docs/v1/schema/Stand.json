{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Stand.json",
  "title": "Stand",
  "description": "The Stand entity shall represent a perennial planting, such as a vineyard, an orchard, a hop garden or an asparagus planting, whose life cycle extends over several years and is therefore distinct from the seasonal CultivationPeriod.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Stand",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "regionId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Region entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regionId",
      "x-agfoda-references": "Region"
    },
    "cropUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the perennial crop.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cropUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/crops"]
    },
    "plantingDate": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of planting.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/plantingDate"
    },
    "varietyUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the variety.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/varietyUri"
    },
    "varietyName": {
      "type": "string",
      "description": "Name of the variety.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/varietyName"
    },
    "rootstockUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the rootstock.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/rootstockUri"
    },
    "clearingDate": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of clearing.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clearingDate"
    },
    "rowSpacing": {
      "type": "number",
      "description": "Distance between rows, in metres.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/rowSpacing"
    },
    "plantSpacing": {
      "type": "number",
      "description": "Distance between plants within a row, in metres.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/plantSpacing"
    },
    "plantCount": {
      "type": "integer",
      "description": "Number of plants.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/plantCount"
    },
    "trainingSystem": {
      "type": "string",
      "description": "Training system applied.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/trainingSystem"
    },
    "description": {
      "$ref": "common.json#/$defs/ThingDescription",
      "description": "Thing Description in JSON-LD format. Annex A.13 describes this attribute as a Thing Description, although clause 5.1 f) does not list Stand among the self-describing entities.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "regionId", "cropUri", "plantingDate", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Stand",
  "x-agfoda-package": "P4",
  "x-agfoda-annex": "A.13"
}
