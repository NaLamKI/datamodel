{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Observation.json",
  "title": "Observation",
  "description": "The Observation entity shall record the value of an observed property for a feature of interest at a stated time, in alignment with [ISO 19156] and [OGC SensorThings].",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Observation",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "observedPropertyUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the observed property.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/observedPropertyUri",
      "x-agfoda-schemes": [
        "https://w3id.org/agrifooddata/observed-properties",
        "https://w3id.org/agrifooddata/pests",
        "https://w3id.org/agrifooddata/soil-glosis"
      ]
    },
    "phenomenonTime": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time to which the observation applies.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/phenomenonTime"
    },
    "regionId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Feature of interest.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regionId",
      "x-agfoda-references": "Region"
    },
    "fieldId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Feature of interest.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/fieldId",
      "x-agfoda-references": "Field"
    },
    "siteId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Feature of interest.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/siteId",
      "x-agfoda-references": "Site"
    },
    "animalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Feature of interest.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalId",
      "x-agfoda-references": "Animal"
    },
    "machineId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Feature of interest.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/machineId",
      "x-agfoda-references": "Machine"
    },
    "resultValue": {
      "type": "number",
      "description": "Numeric result of the observation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/resultValue"
    },
    "resultUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the result, expressed as a [UCUM] code.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/resultUnit"
    },
    "resultJson": {
      "description": "Complex result.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/resultJson"
    },
    "deviceId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Device that produced the observation. Absent where the value originates from an external service (clause 8.9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/deviceId",
      "x-agfoda-references": "Device"
    },
    "dataId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Bulk dataset with which the observation is associated.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/dataId",
      "x-agfoda-references": "Data"
    },
    "source": {
      "type": "string",
      "description": "Source of the observation, for example an external service.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/source"
    },
    "validity": {
      "$ref": "enumerations.json#/$defs/ObservationValidity",
      "description": "Outcome of quality assurance.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/validity"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "observedPropertyUri",
    "phenomenonTime",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V03: Exactly one of regionId, fieldId, siteId, animalId, machineId is set.",
      "oneOf": [
        {
          "required": ["regionId"]
        },
        {
          "required": ["fieldId"]
        },
        {
          "required": ["siteId"]
        },
        {
          "required": ["animalId"]
        },
        {
          "required": ["machineId"]
        }
      ]
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Observation",
  "x-agfoda-package": "P9",
  "x-agfoda-annex": "A.31"
}
