{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/AnimalEvent.json",
  "title": "AnimalEvent",
  "description": "The AnimalEvent entity shall record an occurrence relating to an individual animal or to a group. The type of occurrence is given by eventTypeUri and may denote, among others, birth, insemination, pregnancy diagnosis, parturition, drying off, weighing, milk recording, vaccination, treatment, diagnosis, hoof care, relocation, entry, departure or death.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "AnimalEvent",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "eventTypeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the type of event, aligned with [ICAR ADE].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/eventTypeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/event-types"]
    },
    "occurredAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the event occurred.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/occurredAt"
    },
    "animalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Individual animal concerned.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalId",
      "x-agfoda-references": "Animal"
    },
    "animalGroupId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Group concerned.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalGroupId",
      "x-agfoda-references": "AnimalGroup"
    },
    "value": {
      "type": "number",
      "description": "Measured quantity, for example a weight or a milk yield.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/value"
    },
    "valueUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the measured quantity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/valueUnit"
    },
    "diagnosisUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying a diagnosis.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/diagnosisUri"
    },
    "productId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Medicinal product or vaccine administered.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/productId",
      "x-agfoda-references": "Product"
    },
    "lotId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Lot of the product used. Required for the traceability of medicinal products and of semen (clause 8.8).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/lotId",
      "x-agfoda-references": "Lot"
    },
    "dosage": {
      "type": "number",
      "description": "Dose administered.",
      "exclusiveMinimum": 0,
      "$comment": "Rule V02: a quantity is greater than zero.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/dosage"
    },
    "dosageUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the dose.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/dosageUnit"
    },
    "relatedAnimalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Related animal, for example the sire, the offspring or the dam.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/relatedAnimalId",
      "x-agfoda-references": "Animal"
    },
    "withdrawalUntilMilk": {
      "$ref": "common.json#/$defs/Date",
      "description": "End of the withdrawal period for milk. Calculated and stored where a treatment references a product with withdrawalPeriodDays (rule V11).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/withdrawalUntilMilk"
    },
    "withdrawalUntilMeat": {
      "$ref": "common.json#/$defs/Date",
      "description": "End of the withdrawal period for meat. Calculated and stored where a treatment references a product with withdrawalPeriodDays (rule V11).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/withdrawalUntilMeat"
    },
    "performedByWorkerId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Person who performed the event.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/performedByWorkerId",
      "x-agfoda-references": "Worker"
    },
    "vetOrganizationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Veterinary practice involved.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/vetOrganizationId",
      "x-agfoda-references": "Organization"
    },
    "activityId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Related operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityId",
      "x-agfoda-references": "Activity"
    },
    "notes": {
      "type": "string",
      "description": "Remarks.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/notes"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "eventTypeUri", "occurredAt", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V03: Exactly one of animalId, animalGroupId is set.",
      "oneOf": [
        {
          "required": ["animalId"]
        },
        {
          "required": ["animalGroupId"]
        }
      ]
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/AnimalEvent",
  "x-agfoda-package": "P8",
  "x-agfoda-annex": "A.27"
}
