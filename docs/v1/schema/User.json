{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/User.json",
  "title": "User",
  "description": "The User entity shall represent an individual person who interacts with the system through an account.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "User",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Electronic mail address, serving as the login identity. Unique within the deployment (Table 3).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/email"
    },
    "firstname": {
      "type": "string",
      "description": "First name of the user.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/firstname"
    },
    "lastname": {
      "type": "string",
      "description": "Last name of the user.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/lastname"
    },
    "organizationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Organization entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/organizationId",
      "x-agfoda-references": "Organization"
    },
    "phone": {
      "type": "string",
      "description": "Telephone number.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/phone"
    },
    "locale": {
      "$ref": "common.json#/$defs/LanguageTag",
      "description": "Language tag conforming to [IETF BCP 47].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/locale"
    },
    "status": {
      "$ref": "enumerations.json#/$defs/UserStatus",
      "description": "Status of the account.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/userStatus"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "email",
    "firstname",
    "lastname",
    "organizationId",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/User",
  "x-agfoda-package": "P1",
  "x-agfoda-annex": "A.2",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [["INVITED", "ACTIVE"], ["ACTIVE", "DEACTIVATED"], ["DEACTIVATED", "ACTIVE"]],
    "terminal": []
  },
  "x-agfoda-unique": [
    {
      "attributes": ["email"],
      "scope": "the deployment"
    }
  ]
}
