{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Product.json",
  "title": "Product",
  "description": "The Product entity shall represent the master data of an input or of produce.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Product",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Name of the product.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "category": {
      "$ref": "enumerations.json#/$defs/ProductCategory",
      "description": "Category of the product.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/category"
    },
    "typeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the substance or product class.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/product-classes"]
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer of the product.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/manufacturer"
    },
    "registrationNumber": {
      "type": "string",
      "description": "Authorization number. Unique within the authorization scheme concerned (Table 3).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/registrationNumber"
    },
    "composition": {
      "type": "object",
      "description": "Nutrient contents or active substances with their concentrations.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/composition"
    },
    "defaultUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Default unit, expressed as a [UCUM] code.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/defaultUnit"
    },
    "gtin": {
      "$ref": "common.json#/$defs/Gtin",
      "description": "Global trade item number.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/gtin"
    },
    "safetyInfo": {
      "type": "object",
      "description": "Conditions of use, for example buffer distances or pollinator protection.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/safetyInfo"
    },
    "withdrawalPeriodDays": {
      "type": "integer",
      "description": "Withdrawal period in days.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/withdrawalPeriodDays"
    },
    "organicApproved": {
      "type": "boolean",
      "description": "Approved for use in organic production.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/organicApproved"
    },
    "externalId": {
      "type": "string",
      "description": "Identifier in an external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalId"
    },
    "externalProvider": {
      "type": "string",
      "description": "Identifier of the external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalProvider"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "name", "category", "typeUri", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "clause 8.6: registrationNumber is set where category is PLANT_PROTECTION or VETERINARY_MEDICINE.",
      "if": {
        "properties": {
          "category": {
            "enum": ["PLANT_PROTECTION", "VETERINARY_MEDICINE"]
          }
        },
        "required": ["category"]
      },
      "then": {
        "required": ["registrationNumber"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Product",
  "x-agfoda-package": "P6",
  "x-agfoda-annex": "A.19",
  "x-agfoda-unique": [
    {
      "attributes": ["registrationNumber"],
      "scope": "the authorization scheme concerned"
    }
  ]
}
