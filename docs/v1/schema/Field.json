{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Field.json",
  "title": "Field",
  "description": "The Field entity shall represent a single, contiguous parcel of land managed as part of the farm. It is a core geospatial entity.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Field",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Name of the field. Unique within farmId (Table 3).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Farm entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "geometry": {
      "$ref": "common.json#/$defs/Geometry",
      "description": "GeoJSON field boundary.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/geometry"
    },
    "area": {
      "type": "number",
      "description": "Area of the field.",
      "exclusiveMinimum": 0,
      "$comment": "Rule V02: a quantity is greater than zero.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/area"
    },
    "areaUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the area, by default hectares.",
      "default": "har",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/areaUnit"
    },
    "landUseUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Type of land use.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/landUseUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/land-use"]
    },
    "cadastralReference": {
      "type": "string",
      "description": "Reference into a land parcel identification system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cadastralReference"
    },
    "tenure": {
      "$ref": "enumerations.json#/$defs/Tenure",
      "description": "Tenure under which the field is managed.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/tenure"
    },
    "description": {
      "$ref": "common.json#/$defs/ThingDescription",
      "description": "Thing Description in JSON-LD format.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "code": {
      "type": "string",
      "description": "Internal short code.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/code"
    },
    "state": {
      "type": "string",
      "description": "Region or administrative subdivision.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/state"
    },
    "country": {
      "$ref": "common.json#/$defs/CountryCode",
      "description": "Country code conforming to [ISO 3166-1].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/country"
    },
    "startsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Start of the period of management.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/startsAt"
    },
    "endsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "End of the period of management.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/endsAt"
    },
    "externalId": {
      "type": "string",
      "description": "Identifier in an external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalId"
    },
    "externalProvider": {
      "type": "string",
      "description": "Identifier of the external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalProvider"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "name", "farmId", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Field",
  "x-agfoda-package": "P3",
  "x-agfoda-annex": "A.9",
  "x-agfoda-unique": [
    {
      "attributes": ["name"],
      "within": ["farmId"]
    }
  ]
}
