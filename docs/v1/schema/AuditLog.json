{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/AuditLog.json",
  "title": "AuditLog",
  "description": "The AuditLog entity shall record changes to the records of the model. The audit log shall be persisted in an append-only manner and should be exportable in accordance with W3C PROV-O.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "AuditLog",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "entityType": {
      "$ref": "common.json#/$defs/EntityName",
      "description": "Type of the entity concerned.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/entityType"
    },
    "entityId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Identifier of the record concerned.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/entityId",
      "x-agfoda-references-by": {
        "attribute": "entityType"
      }
    },
    "action": {
      "$ref": "enumerations.json#/$defs/AuditAction",
      "description": "Kind of change.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/action"
    },
    "changedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the change.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/changedAt"
    },
    "changedByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who made the change.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/changedByUserId",
      "x-agfoda-references": "User"
    },
    "changedByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that made the change.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/changedByJobId",
      "x-agfoda-references": "ProcessingJob"
    },
    "changeSet": {
      "$ref": "common.json#/$defs/ChangeSet",
      "description": "Values before and after the change.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/changeSet"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the change. Shall be given for subsequent corrections (clause 8.11).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/reason"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "entityType",
    "entityId",
    "action",
    "changedAt",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/AuditLog",
  "x-agfoda-package": "P11",
  "x-agfoda-annex": "A.40"
}
