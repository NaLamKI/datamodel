{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Site.json",
  "title": "Site",
  "description": "The Site entity shall represent a built or technical location of the holding, such as a barn, a greenhouse compartment, a storage building, a silo, a farmyard, a biogas plant or a machinery shed. It complements the field-centred spatial structure and carries animal housing, protected cultivation and storage locations.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Site",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Designation of the site.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Farm entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "siteTypeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Type of site, for example barn, greenhouse compartment or store.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/siteTypeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/site-types"]
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/Point"
        },
        {
          "$ref": "common.json#/$defs/Polygon"
        }
      ],
      "description": "GeoJSON Point or Polygon.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/geometry"
    },
    "description": {
      "$ref": "common.json#/$defs/ThingDescription",
      "description": "Thing Description in JSON-LD format.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "capacity": {
      "type": "number",
      "description": "Capacity of the site.",
      "exclusiveMinimum": 0,
      "$comment": "Rule V02: a quantity is greater than zero.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/capacity"
    },
    "capacityUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the capacity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/capacityUnit"
    },
    "parentSiteId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Parent site, permitting a hierarchy of compartments.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/parentSiteId",
      "x-agfoda-references": "Site"
    },
    "startsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Start of the period of use.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/startsAt"
    },
    "endsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "End of the period of use.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/endsAt"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "name", "farmId", "siteTypeUri", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Site",
  "x-agfoda-package": "P2",
  "x-agfoda-annex": "A.8"
}
