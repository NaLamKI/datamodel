{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Machine.json",
  "title": "Machine",
  "description": "The Machine entity shall represent a machine or an implement.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Machine",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Designation of the machine.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Farm entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "categoryUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the category of machine.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/categoryUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/machine-categories"]
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/manufacturer"
    },
    "model": {
      "type": "string",
      "description": "Model designation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/model"
    },
    "serialNumber": {
      "type": "string",
      "description": "Serial number.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/serialNumber"
    },
    "year": {
      "type": "integer",
      "description": "Year of construction.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/year"
    },
    "isobusDeviceId": {
      "type": "string",
      "description": "Device identity conforming to [ISO 11783].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/isobusDeviceId"
    },
    "workingWidth": {
      "type": "number",
      "description": "Working width in metres.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/workingWidth"
    },
    "costRatePerHour": {
      "type": "number",
      "description": "Imputed machine hourly rate.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/costRatePerHour"
    },
    "telemetryDeviceId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Device entity supplying telemetry. Live telemetry is not duplicated as an entity; it is attached through Device and Observation (clause 8.7).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/telemetryDeviceId",
      "x-agfoda-references": "Device"
    },
    "status": {
      "$ref": "enumerations.json#/$defs/MachineStatus",
      "description": "Status of the machine.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/machineStatus"
    },
    "externalId": {
      "type": "string",
      "description": "Identifier in an external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalId"
    },
    "externalProvider": {
      "type": "string",
      "description": "Identifier of the external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalProvider"
    },
    "description": {
      "$ref": "common.json#/$defs/ThingDescription",
      "description": "Thing Description in JSON-LD format. Not in the table of Annex A.23; clauses 5.1 f) and 9 list Machine among the entities with a self-description.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "name", "farmId", "categoryUri", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Machine",
  "x-agfoda-package": "P7",
  "x-agfoda-annex": "A.23",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [
      ["ACTIVE", "INACTIVE"],
      ["INACTIVE", "ACTIVE"],
      ["ACTIVE", "SOLD"],
      ["INACTIVE", "SOLD"]
    ],
    "terminal": ["SOLD"]
  }
}
