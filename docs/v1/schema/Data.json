{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Data.json",
  "title": "Data",
  "description": "The Data entity shall be a container for a dataset or a data stream, such as satellite imagery, laboratory reports, yield maps or imagery from unmanned aircraft. In this Recommendation, a dataset denotes a bounded collection of data recorded over a defined period and made available as one or more files, whereas a data stream denotes a continuously updated sequence of observations made available through an endpoint.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Data",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Designation of the dataset.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "typeId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the DataType entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeId",
      "x-agfoda-references": "DataType"
    },
    "regionId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regionId",
      "x-agfoda-references": "Region"
    },
    "fieldId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/fieldId",
      "x-agfoda-references": "Field"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "siteId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/siteId",
      "x-agfoda-references": "Site"
    },
    "cultivationPeriodId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cultivationPeriodId",
      "x-agfoda-references": "CultivationPeriod"
    },
    "activityId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityId",
      "x-agfoda-references": "Activity"
    },
    "animalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalId",
      "x-agfoda-references": "Animal"
    },
    "machineId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/machineId",
      "x-agfoda-references": "Machine"
    },
    "lotId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/lotId",
      "x-agfoda-references": "Lot"
    },
    "capturedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of capture.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/capturedAt"
    },
    "description": {
      "$ref": "common.json#/$defs/ThingDescription",
      "description": "Thing Description in JSON-LD format.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "source": {
      "type": "string",
      "description": "Origin of the data.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/source"
    },
    "iamResourceId": {
      "type": "string",
      "description": "Resource identifier in the external IAM system for finer-grained access control. Registers an individual dataset as a protected resource of its own, below the level of the farm (clause 7.3).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/accessResourceId"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "name", "typeId", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V03: Exactly one of regionId, fieldId, farmId, siteId, cultivationPeriodId, activityId, animalId, machineId, lotId is set.",
      "oneOf": [
        {
          "required": ["regionId"]
        },
        {
          "required": ["fieldId"]
        },
        {
          "required": ["farmId"]
        },
        {
          "required": ["siteId"]
        },
        {
          "required": ["cultivationPeriodId"]
        },
        {
          "required": ["activityId"]
        },
        {
          "required": ["animalId"]
        },
        {
          "required": ["machineId"]
        },
        {
          "required": ["lotId"]
        }
      ]
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Data",
  "x-agfoda-package": "P9",
  "x-agfoda-annex": "A.32"
}
