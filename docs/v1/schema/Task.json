{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Task.json",
  "title": "Task",
  "description": "The Task entity shall represent work that is planned or ordered and that has not yet been carried out. It may be addressed from the office to an operator, and it may arise from a recommendation produced by a processing service, thereby closing the digital twin control loop described in clause 7.1.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Task",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Designation of the task.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Farm entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "status": {
      "$ref": "enumerations.json#/$defs/TaskStatus",
      "description": "Status of the task.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/taskStatus"
    },
    "typeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Type of operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/activity-types"]
    },
    "priority": {
      "$ref": "enumerations.json#/$defs/TaskPriority",
      "description": "Priority of the task.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/priority"
    },
    "dueAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Latest time by which the task is to be carried out.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/dueAt"
    },
    "earliestStartAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Earliest time at which the task may start.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/earliestStartAt"
    },
    "instructions": {
      "type": "string",
      "description": "Instructions for the operator.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/instructions"
    },
    "cultivationPeriodId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cultivationPeriodId",
      "x-agfoda-references": "CultivationPeriod"
    },
    "regionId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regionId",
      "x-agfoda-references": "Region"
    },
    "siteId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/siteId",
      "x-agfoda-references": "Site"
    },
    "animalGroupId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalGroupId",
      "x-agfoda-references": "AnimalGroup"
    },
    "assignedWorkerId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Worker to whom the task is assigned.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/assignedWorkerId",
      "x-agfoda-references": "Worker"
    },
    "assignedMachineId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Machine assigned to the task.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/assignedMachineId",
      "x-agfoda-references": "Machine"
    },
    "sourceResultId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Result from which the task arose.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/sourceResultId",
      "x-agfoda-references": "Result"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "name", "farmId", "status", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Task",
  "x-agfoda-package": "P5",
  "x-agfoda-annex": "A.15",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [
      ["PLANNED", "ASSIGNED"],
      ["ASSIGNED", "IN_PROGRESS"],
      ["IN_PROGRESS", "COMPLETED"],
      ["ASSIGNED", "PLANNED"],
      ["PLANNED", "CANCELLED"],
      ["ASSIGNED", "CANCELLED"],
      ["IN_PROGRESS", "CANCELLED"]
    ],
    "terminal": ["COMPLETED", "CANCELLED"]
  }
}
