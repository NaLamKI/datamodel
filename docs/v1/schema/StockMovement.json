{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/StockMovement.json",
  "title": "StockMovement",
  "description": "The StockMovement entity shall record a movement of stock.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "StockMovement",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "movementType": {
      "$ref": "enumerations.json#/$defs/MovementType",
      "description": "Kind of movement.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/movementType"
    },
    "productId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Product entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/productId",
      "x-agfoda-references": "Product"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity moved.",
      "exclusiveMinimum": 0,
      "$comment": "Rule V02: a quantity is greater than zero.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/quantity"
    },
    "unit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the quantity, expressed as a [UCUM] code.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/unit"
    },
    "occurredAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the movement occurred.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/occurredAt"
    },
    "lotId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Lot entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/lotId",
      "x-agfoda-references": "Lot"
    },
    "fromStorageLocationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Source storage location. Set as appropriate to the movement type (clause 8.6).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/fromStorageLocationId",
      "x-agfoda-references": "StorageLocation"
    },
    "toStorageLocationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Destination storage location. Set as appropriate to the movement type (clause 8.6).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/toStorageLocationId",
      "x-agfoda-references": "StorageLocation"
    },
    "activityId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operation that caused the movement.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityId",
      "x-agfoda-references": "Activity"
    },
    "inputOutputId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Link to the corresponding economic record.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/inputOutputId",
      "x-agfoda-references": "InputOutput"
    },
    "counterpartyOrganizationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Trading partner in a purchase or a sale.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/counterpartyOrganizationId",
      "x-agfoda-references": "Organization"
    },
    "documentRef": {
      "type": "string",
      "description": "Reference to a delivery note or an invoice.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/documentRef"
    },
    "documentFileId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the File entity holding the scanned document.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/documentFileId",
      "x-agfoda-references": "File"
    },
    "recordedByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who recorded the movement.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/recordedByUserId",
      "x-agfoda-references": "User"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "movementType",
    "productId",
    "quantity",
    "unit",
    "occurredAt",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/StockMovement",
  "x-agfoda-package": "P6",
  "x-agfoda-annex": "A.22"
}
