{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Budget.json",
  "title": "Budget",
  "description": "The Budget entity shall hold planned values for a defined scope and period.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Budget",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Name of the budget.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Farm entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "scopeType": {
      "$ref": "enumerations.json#/$defs/BudgetScopeType",
      "description": "Kind of object the budget applies to.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/budgetScopeType"
    },
    "periodStart": {
      "$ref": "common.json#/$defs/Date",
      "description": "Start of the budget period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/periodStart"
    },
    "periodEnd": {
      "$ref": "common.json#/$defs/Date",
      "description": "End of the budget period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/periodEnd"
    },
    "currency": {
      "$ref": "common.json#/$defs/CurrencyCode",
      "description": "Currency code conforming to [ISO 4217].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/currency"
    },
    "scopeRefId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Reference to the object identified by scopeType. A cost category is a concept, not a record; for COST_CATEGORY the reference has no defined target (see divergence R6).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/scopeRefId",
      "x-agfoda-references-by": {
        "attribute": "scopeType",
        "targets": {
          "FARM": "Farm",
          "CULTIVATION_PERIOD": "CultivationPeriod",
          "ANIMAL_GROUP": "AnimalGroup",
          "COST_CATEGORY": null
        }
      }
    },
    "plannedRevenue": {
      "type": "number",
      "description": "Planned revenue.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/plannedRevenue"
    },
    "plannedCosts": {
      "type": "number",
      "description": "Planned costs.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/plannedCosts"
    },
    "notes": {
      "type": "string",
      "description": "Remarks.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/notes"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "name",
    "farmId",
    "scopeType",
    "periodStart",
    "periodEnd",
    "currency",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Budget",
  "x-agfoda-package": "P10",
  "x-agfoda-annex": "A.37"
}
