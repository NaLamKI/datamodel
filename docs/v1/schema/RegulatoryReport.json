{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/RegulatoryReport.json",
  "title": "RegulatoryReport",
  "description": "The RegulatoryReport entity shall represent a formal, versioned artefact generated from operational data for submission to an authority or a certification body.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "RegulatoryReport",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "farmId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Farm entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/farmId",
      "x-agfoda-references": "Farm"
    },
    "reportTypeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the type of report.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/reportTypeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/report-types"]
    },
    "status": {
      "$ref": "enumerations.json#/$defs/RegulatoryReportStatus",
      "description": "Status of the report.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regulatoryReportStatus"
    },
    "periodStart": {
      "$ref": "common.json#/$defs/Date",
      "description": "Start of the reporting period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/periodStart"
    },
    "periodEnd": {
      "$ref": "common.json#/$defs/Date",
      "description": "End of the reporting period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/periodEnd"
    },
    "format": {
      "type": "string",
      "description": "Format of the generated artefact.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/format"
    },
    "payloadFileId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the File entity holding the generated artefact.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/payloadFileId",
      "x-agfoda-references": "File"
    },
    "submittedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of submission.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/submittedAt"
    },
    "authority": {
      "type": "string",
      "description": "Receiving body.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/authority"
    },
    "submissionRef": {
      "type": "string",
      "description": "Reference assigned by the receiving body.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/submissionRef"
    },
    "supersedesReportId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Earlier report corrected or replaced by this report.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/supersedesReportId",
      "x-agfoda-references": "RegulatoryReport"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "farmId", "reportTypeUri", "status", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/RegulatoryReport",
  "x-agfoda-package": "P11",
  "x-agfoda-annex": "A.38",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [
      ["DRAFT", "GENERATED"],
      ["GENERATED", "SUBMITTED"],
      ["SUBMITTED", "ACCEPTED"],
      ["SUBMITTED", "REJECTED"],
      ["REJECTED", "GENERATED"],
      ["GENERATED", "DRAFT"]
    ],
    "terminal": ["ACCEPTED"]
  }
}
