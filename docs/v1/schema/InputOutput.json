{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/InputOutput.json",
  "title": "InputOutput",
  "description": "The InputOutput entity shall be a generic container quantifying any resource that is consumed or produced.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "InputOutput",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "amount": {
      "type": "number",
      "description": "Quantity consumed or produced.",
      "exclusiveMinimum": 0,
      "$comment": "Rule V02: a quantity is greater than zero.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/amount"
    },
    "unit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the quantity, expressed as a [UCUM] code.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/unit"
    },
    "ioType": {
      "$ref": "enumerations.json#/$defs/IOType",
      "description": "Whether the resource is consumed or produced.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/ioType"
    },
    "valueType": {
      "$ref": "enumerations.json#/$defs/ValueType",
      "description": "Whether the quantity is planned, actual, estimated or predicted.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/valueType"
    },
    "typeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the substance or the produce.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/product-classes"]
    },
    "activityId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Assignment.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityId",
      "x-agfoda-references": "Activity"
    },
    "cultivationPeriodId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Assignment.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cultivationPeriodId",
      "x-agfoda-references": "CultivationPeriod"
    },
    "animalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Assignment.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalId",
      "x-agfoda-references": "Animal"
    },
    "animalGroupId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Assignment.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalGroupId",
      "x-agfoda-references": "AnimalGroup"
    },
    "productId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Product entity. Shall be set for products of category PLANT_PROTECTION and VETERINARY_MEDICINE and should be set for all other real inputs (clause 8.10, rule V10).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/productId",
      "x-agfoda-references": "Product"
    },
    "lotId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Lot entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/lotId",
      "x-agfoda-references": "Lot"
    },
    "description": {
      "type": "string",
      "description": "Remarks.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "amount",
    "unit",
    "ioType",
    "valueType",
    "typeUri",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V03: Exactly one of activityId, cultivationPeriodId, animalId, animalGroupId is set.",
      "oneOf": [
        {
          "required": ["activityId"]
        },
        {
          "required": ["cultivationPeriodId"]
        },
        {
          "required": ["animalId"]
        },
        {
          "required": ["animalGroupId"]
        }
      ]
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/InputOutput",
  "x-agfoda-package": "P10",
  "x-agfoda-annex": "A.35"
}
