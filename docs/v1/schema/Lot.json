{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Lot.json",
  "title": "Lot",
  "description": "The Lot entity shall represent a quantity of a product treated as a single traceable unit. It is the core entity of traceability.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Lot",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "lotNumber": {
      "type": "string",
      "description": "Lot number. Unique within productId, together with the origin reference for own production (Table 3).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/lotNumber"
    },
    "productId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Product entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/productId",
      "x-agfoda-references": "Product"
    },
    "originCultivationPeriodId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Origin in own crop production.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originCultivationPeriodId",
      "x-agfoda-references": "CultivationPeriod"
    },
    "originAnimalGroupId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Origin in own animal production.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originAnimalGroupId",
      "x-agfoda-references": "AnimalGroup"
    },
    "supplierOrganizationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Supplier of a purchased lot.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/supplierOrganizationId",
      "x-agfoda-references": "Organization"
    },
    "productionDate": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of production.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/productionDate"
    },
    "expiryDate": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of expiry.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/expiryDate"
    },
    "attributes": {
      "type": "object",
      "description": "Quality characteristics of the lot.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/attributes"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "lotNumber", "productId", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V13: At most one of originCultivationPeriodId, originAnimalGroupId is set.",
      "not": {
        "anyOf": [
          {
            "required": ["originCultivationPeriodId", "originAnimalGroupId"]
          }
        ]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Lot",
  "x-agfoda-package": "P6",
  "x-agfoda-annex": "A.21",
  "x-agfoda-unique": [
    {
      "attributes": ["lotNumber"],
      "within": ["productId"],
      "text": "together with the origin reference for own production"
    }
  ]
}
