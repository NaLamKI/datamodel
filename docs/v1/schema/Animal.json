{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Animal.json",
  "title": "Animal",
  "description": "The Animal entity shall represent an individual animal.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Animal",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "speciesUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the species.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/speciesUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/animal-species"]
    },
    "status": {
      "$ref": "enumerations.json#/$defs/AnimalStatus",
      "description": "Status of the animal.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalStatus"
    },
    "officialId": {
      "type": "string",
      "description": "Official identification. Shall be set where the species is subject to official identification (clause 8.8).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/officialId"
    },
    "name": {
      "type": "string",
      "description": "Name of the animal.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "breedUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the breed.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/breedUri"
    },
    "sex": {
      "$ref": "enumerations.json#/$defs/AnimalSex",
      "description": "Sex of the animal.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/sex"
    },
    "birthDate": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of birth.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/birthDate"
    },
    "motherAnimalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Dam of the animal.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/motherAnimalId",
      "x-agfoda-references": "Animal"
    },
    "fatherAnimalId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Sire of the animal.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/fatherAnimalId",
      "x-agfoda-references": "Animal"
    },
    "currentGroupId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Current animal group; the history is available through AnimalEvent. A denormalized value (clause 8.8).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/currentGroupId",
      "x-agfoda-references": "AnimalGroup"
    },
    "currentSiteId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Current site.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/currentSiteId",
      "x-agfoda-references": "Site"
    },
    "enteredAt": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of entry to the holding.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/enteredAt"
    },
    "leftAt": {
      "$ref": "common.json#/$defs/Date",
      "description": "Date of departure from the holding.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/leftAt"
    },
    "externalId": {
      "type": "string",
      "description": "Identifier in an external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalId"
    },
    "externalProvider": {
      "type": "string",
      "description": "Identifier of the external system.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/externalProvider"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "speciesUri", "status", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Animal",
  "x-agfoda-package": "P8",
  "x-agfoda-annex": "A.25",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [
      ["ACTIVE", "SOLD"],
      ["ACTIVE", "SLAUGHTERED"],
      ["ACTIVE", "DEAD"],
      ["ACTIVE", "TRANSFERRED"]
    ],
    "terminal": ["SOLD", "SLAUGHTERED", "DEAD", "TRANSFERRED"]
  },
  "x-agfoda-unique": [
    {
      "attributes": ["officialId"],
      "within": ["externalProvider"],
      "scope": "the official numbering scheme"
    }
  ]
}
