{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Activity.json",
  "title": "Activity",
  "description": "The Activity entity shall represent an operation that has been carried out, such as ploughing, sowing, application of a plant protection product or a fertilizer, irrigation, harvesting or work in a building.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Activity",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Designation of the activity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "startsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Start of the operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/startsAt"
    },
    "endsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "End of the operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/endsAt"
    },
    "typeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the type of operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/activity-types"]
    },
    "typeLabel": {
      "type": "string",
      "description": "Human-readable label for the type of operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeLabel"
    },
    "status": {
      "$ref": "enumerations.json#/$defs/ActivityStatus",
      "description": "Status of the operation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityStatus"
    },
    "taskId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Task entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/taskId",
      "x-agfoda-references": "Task"
    },
    "cultivationPeriodId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cultivationPeriodId",
      "x-agfoda-references": "CultivationPeriod"
    },
    "regionId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regionId",
      "x-agfoda-references": "Region"
    },
    "siteId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/siteId",
      "x-agfoda-references": "Site"
    },
    "animalGroupId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Operational context.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/animalGroupId",
      "x-agfoda-references": "AnimalGroup"
    },
    "geometry": {
      "$ref": "common.json#/$defs/Geometry",
      "description": "GeoJSON representation of the extent actually treated. Should lie within the geometry of the spatial unit referenced (rule V06).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/geometry"
    },
    "bbchStage": {
      "type": "string",
      "description": "Growth stage of the crop at the time of the operation. Should be set for the application of a plant protection product (rule V09).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/bbchStage",
      "x-agfoda-notation-from": "https://w3id.org/agrifooddata/phenology"
    },
    "conditions": {
      "type": "object",
      "description": "Conditions of application, for example wind speed, temperature and soil condition.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/conditions"
    },
    "isobusTaskRef": {
      "type": "string",
      "description": "Reference to task data conforming to [ISO 11783-10].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/isobusTaskRef"
    },
    "description": {
      "type": "string",
      "description": "Remarks.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "name",
    "startsAt",
    "endsAt",
    "typeUri",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "clause 8.5: At least one of cultivationPeriodId, regionId, siteId, animalGroupId is set.",
      "anyOf": [
        {
          "required": ["cultivationPeriodId"]
        },
        {
          "required": ["regionId"]
        },
        {
          "required": ["siteId"]
        },
        {
          "required": ["animalGroupId"]
        }
      ]
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Activity",
  "x-agfoda-package": "P5",
  "x-agfoda-annex": "A.16",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [["IN_PROGRESS", "COMPLETED"], ["IN_PROGRESS", "ABORTED"]],
    "terminal": ["COMPLETED", "ABORTED"]
  }
}
