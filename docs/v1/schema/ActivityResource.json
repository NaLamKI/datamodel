{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/ActivityResource.json",
  "title": "ActivityResource",
  "description": "The ActivityResource entity shall record the deployment of a machine or of a person in an operation, resolving the many-to-many relationship between operations and resources. It is the basis for the attribution of machine costs and labour costs.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "ActivityResource",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "activityId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Activity entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityId",
      "x-agfoda-references": "Activity"
    },
    "resourceType": {
      "$ref": "enumerations.json#/$defs/ResourceType",
      "description": "Kind of resource deployed.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/resourceType"
    },
    "machineId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Machine entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/machineId",
      "x-agfoda-references": "Machine"
    },
    "workerId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Worker entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/workerId",
      "x-agfoda-references": "Worker"
    },
    "role": {
      "type": "string",
      "description": "Role of the resource, for example operator, tractor or implement.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/role"
    },
    "startsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Start of the deployment.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/startsAt"
    },
    "endsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "End of the deployment.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/endsAt"
    },
    "usageAmount": {
      "type": "number",
      "description": "Quantity of use, for example operating hours, distance or area worked.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/usageAmount"
    },
    "usageUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the quantity of use.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/usageUnit"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "activityId", "resourceType", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V03: Exactly one of machineId, workerId is set.",
      "oneOf": [
        {
          "required": ["machineId"]
        },
        {
          "required": ["workerId"]
        }
      ]
    },
    {
      "$comment": "clause 8.5: machineId is set where resourceType is MACHINE.",
      "if": {
        "properties": {
          "resourceType": {
            "enum": ["MACHINE"]
          }
        },
        "required": ["resourceType"]
      },
      "then": {
        "required": ["machineId"]
      }
    },
    {
      "$comment": "clause 8.5: workerId is set where resourceType is WORKER.",
      "if": {
        "properties": {
          "resourceType": {
            "enum": ["WORKER"]
          }
        },
        "required": ["resourceType"]
      },
      "then": {
        "required": ["workerId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/ActivityResource",
  "x-agfoda-package": "P5",
  "x-agfoda-annex": "A.17"
}
