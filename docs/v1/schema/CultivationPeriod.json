{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/CultivationPeriod.json",
  "title": "CultivationPeriod",
  "description": "The CultivationPeriod entity shall represent the cultivation of a specific crop, including its cultivar, on a specific Region over a defined period of time. The period is not restricted to a single growing season: depending on crop type, cultivar, environmental conditions and management practice, it may cover part of a season, a full season, or several successive or overlapping cultivation cycles. Where cultivation cycles overlap in time on the same region, each cycle shall be represented by a separate CultivationPeriod instance. For a perennial planting it represents the annual vegetative cycle of a Stand.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "CultivationPeriod",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "name": {
      "type": "string",
      "description": "Designation of the cultivation period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/name"
    },
    "startsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Start of the cultivation period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/startsAt"
    },
    "endsAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "End of the cultivation period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/endsAt"
    },
    "regionId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Region entity.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/regionId",
      "x-agfoda-references": "Region"
    },
    "typeUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the crop cultivated.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/typeUri",
      "x-agfoda-schemes": ["https://w3id.org/agrifooddata/crops"]
    },
    "varietyUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the variety.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/varietyUri"
    },
    "varietyName": {
      "type": "string",
      "description": "Name of the variety.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/varietyName"
    },
    "standId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the Stand entity for a perennial planting. Shall reference a Stand of the same Region (rule V08).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/standId",
      "x-agfoda-references": "Stand"
    },
    "planEntryId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Foreign key to the CroppingPlanEntry entity, linking plan and outcome. Where set, typeUri should correspond to CroppingPlanEntry.cropUri (rule V07).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/planEntryId",
      "x-agfoda-references": "CroppingPlanEntry"
    },
    "status": {
      "$ref": "enumerations.json#/$defs/CultivationPeriodStatus",
      "description": "Status of the cultivation period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/cultivationPeriodStatus"
    },
    "expectedYield": {
      "type": "number",
      "description": "Expected yield.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/expectedYield"
    },
    "expectedYieldUnit": {
      "$ref": "common.json#/$defs/UcumCode",
      "description": "Unit of the expected yield.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/expectedYieldUnit"
    },
    "geometry": {
      "$ref": "common.json#/$defs/Geometry",
      "description": "Subset of the geometry of the parent region, where applicable. A subset of the geometry of the parent region, where the crop does not occupy the whole area (clause 8.4).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/geometry"
    },
    "description": {
      "type": "string",
      "description": "Description of the cultivation period.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/description"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": [
    "id",
    "name",
    "startsAt",
    "endsAt",
    "regionId",
    "typeUri",
    "createdAt",
    "updatedAt",
    "originType"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/CultivationPeriod",
  "x-agfoda-package": "P4",
  "x-agfoda-annex": "A.14",
  "x-agfoda-states": {
    "attribute": "status",
    "transitions": [
      ["PLANNED", "ACTIVE"],
      ["ACTIVE", "COMPLETED"],
      ["PLANNED", "ABORTED"],
      ["ACTIVE", "ABORTED"]
    ],
    "terminal": ["COMPLETED", "ABORTED"]
  }
}
