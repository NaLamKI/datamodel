{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodel.agrifooddata.org/v1/schema/Economics.json",
  "title": "Economics",
  "description": "The Economics entity shall attach a monetary value to a quantity, a stock movement or the deployment of a resource.",
  "type": "object",
  "properties": {
    "@context": {
      "$ref": "common.json#/$defs/JsonLdContext"
    },
    "@id": {
      "$ref": "common.json#/$defs/JsonLdId"
    },
    "@type": {
      "const": "Economics",
      "description": "The entity, in a JSON-LD representation."
    },
    "id": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Unique identifier of the record, its primary key. Generated by the client that creates the record, so that records created while offline do not collide (clauses 5.1 a) and 9).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/id"
    },
    "value": {
      "type": "number",
      "description": "Monetary amount; may be negative to permit credits and corrections.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/value"
    },
    "unit": {
      "$ref": "common.json#/$defs/CurrencyCode",
      "description": "Currency code conforming to [ISO 4217].",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/unit"
    },
    "valueType": {
      "$ref": "enumerations.json#/$defs/ValueType",
      "description": "Whether the value is planned, actual, estimated or predicted.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/valueType"
    },
    "inputOutputId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Object valued.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/inputOutputId",
      "x-agfoda-references": "InputOutput"
    },
    "stockMovementId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Object valued.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/stockMovementId",
      "x-agfoda-references": "StockMovement"
    },
    "activityResourceId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Object valued.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/activityResourceId",
      "x-agfoda-references": "ActivityResource"
    },
    "date": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Date of entry or of valuation.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/date"
    },
    "vatRate": {
      "type": "number",
      "description": "Value added tax rate.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/vatRate"
    },
    "costCategoryUri": {
      "$ref": "common.json#/$defs/ConceptUri",
      "description": "Concept identifying the cost category.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/costCategoryUri"
    },
    "counterpartyOrganizationId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Trading partner.",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/counterpartyOrganizationId",
      "x-agfoda-references": "Organization"
    },
    "createdAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time at which the record was created, set by the system.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdAt"
    },
    "updatedAt": {
      "$ref": "common.json#/$defs/DateTime",
      "description": "Time of the last change to the record, set by the system. The cursor of offline synchronization and the basis of per-attribute last-write-wins conflict resolution (clauses 5.1 b) and 9).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/updatedAt"
    },
    "originType": {
      "$ref": "enumerations.json#/$defs/OriginType",
      "description": "How the record came into being. Set when the record is created and not modified afterwards (clause 5.1 l)).",
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/originType"
    },
    "createdByUserId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "User who created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByUser",
      "x-agfoda-references": "User"
    },
    "createdByJobId": {
      "$ref": "common.json#/$defs/Uuid",
      "description": "Processing run that created the record. The service responsible follows transitively from ProcessingJob.serviceId (clause 5.1 l)).",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/createdByJob",
      "x-agfoda-references": "ProcessingJob"
    },
    "clientId": {
      "type": "string",
      "description": "Application or interface client that created the record.",
      "readOnly": true,
      "x-agfoda-property": "https://w3id.org/agrifooddata/term/clientId"
    }
  },
  "required": ["id", "value", "unit", "valueType", "createdAt", "updatedAt", "originType"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "V04: createdByUserId is set where originType is USER.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["USER"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByUserId"]
      }
    },
    {
      "$comment": "V04: createdByJobId is set where originType is SERVICE.",
      "if": {
        "properties": {
          "originType": {
            "enum": ["SERVICE"]
          }
        },
        "required": ["originType"]
      },
      "then": {
        "required": ["createdByJobId"]
      }
    },
    {
      "$comment": "V03: Exactly one of inputOutputId, stockMovementId, activityResourceId is set.",
      "oneOf": [
        {
          "required": ["inputOutputId"]
        },
        {
          "required": ["stockMovementId"]
        },
        {
          "required": ["activityResourceId"]
        }
      ]
    }
  ],
  "x-agfoda-class": "https://w3id.org/agrifooddata/term/Economics",
  "x-agfoda-package": "P10",
  "x-agfoda-annex": "A.36"
}
